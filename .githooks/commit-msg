#!/bin/bash
# Enforce conventional commits format

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Pattern: type(scope): subject
# Valid types: feat, fix, refactor, test, docs, chore, perf, ci
pattern='^(feat|fix|refactor|test|docs|chore|perf|ci)(\(.+\))?: .{1,50}'

if ! echo "$commit_msg" | grep -qE "$pattern"; then
    echo "❌ Commit message must follow conventional commits format:"
    echo "   <type>(<scope>): <subject>"
    echo ""
    echo "Valid types: feat, fix, refactor, test, docs, chore, perf, ci"
    echo "Example: feat(auth): implement OAuth2"
    exit 1
fi

exit 0
